/* ChangeLogViewController – Einträge (CL-Präfix) */
"CL Live Transcripts" = "Live-Transkripte – Wenn ein Podcast Transkripte bereitstellt, wird der gesprochene Text live im Player angezeigt, synchron zur Wiedergabe. Tippe auf eine Zeile, um dorthin zu springen. Der Text scrollt automatisch mit und hebt die aktuelle Stelle hervor.";
"CL Intelligent Sleep Timer" = "Intelligenter Sleep-Timer – Startet auf Wunsch automatisch bei jeder Wiedergabe. Setzt sich zurück, wenn Bildschirmberührung, Lautstärketasten oder Gerätebewegung erkannt wird. Einstellbare Bewegungsempfindlichkeit. Optional deaktivierbar bei CarPlay.";
"CL Auto-Skip Chapters" = "Kapitel automatisch überspringen – Schlüsselwörter definieren, um passende Kapitel automatisch zu überspringen. Start-/End-Offsets pro Stichwort für Feinabstimmung. Zusätzlich: feste Anzahl Sekunden am Anfang oder Ende jeder Episode überspringen. Pro Podcast konfigurierbar.";
"CL Redesigned Now Playing" = "Überarbeiteter Now-Playing-Bereich – Grösserer Play-Button, Kapitelname unter der Seekbar, vergrösserte Seekbar und Zeitanzeigen. Tippe oder ziehe an eine beliebige Stelle der Seekbar. Tippe auf den Podcast-Titel, um zur Episodenliste zu springen.";
"CL Chapter Markers" = "Kapitelmarkierungen auf der Seekbar – Kapitelgrenzen auf einen Blick. Das aktuelle Kapitel wird hervorgehoben.";
"CL Swipeable Chapter Images" = "Wischbare Kapitelbilder – Kapitelbilder durch Wischen durchblättern, ohne die Wiedergabeposition zu ändern.";
"CL Apple Watch" = "Apple Watch – Neue Watch-App mit Episodenliste, Downloads, Offline-Wiedergabe, Kapiteln, Abspielposition und Steuerung direkt am Handgelenk.";
"CL Widgets" = "Widgets – Home- und Sperrbildschirm-Widgets: Now Playing mit Play/Pause-Steuerung, Smart List, Statistik, Watch-Komplikation und kompaktere Listenoptionen. Widget-Akzentfarbe separat einstellbar.";
"CL Backup & Restore" = "Backup & Restore – Vollständiger Export aller Abonnements, Einstellungen, Playlists, Wiedergabestatus und Zugangsdaten. Import mit Live-Fortschritt, einzelne Podcasts überspringbar, jede Datenkategorie einzeln wählbar.";
"CL CarPlay" = "CarPlay – Volle CarPlay-Unterstützung mit Podcast-Liste, Episodenauswahl und Wiedergabesteuerung.";
"CL iPad & macOS" = "iPad & macOS – Eigene Layouts für iPad und Mac. Optimiert für iOS 26 Liquid Glass.";
"CL Podcast Charts" = "Podcast-Charts – Apple Podcast Charts im Verzeichnis, filterbar nach Genre.";
"CL Episode Filters" = "Episoden filtern – Nach Alle, Ungehört, Angefangen, Favoriten oder Heruntergeladen filtern.";
"CL Episode Retention" = "Episoden-Aufbewahrung – Pro Podcast: automatisch nach 1–30 Tagen löschen oder nur die neuesten 1–12 Episoden behalten.";
"CL Pause Podcast Updates" = "Aktualisierung pausieren – Einzelne Podcasts vorübergehend von der Aktualisierung ausschliessen.";
"CL Restore Deleted Episodes" = "Gelöschte Episoden wiederherstellen – Versehentlich gelöschte Episoden in den Podcast-Einstellungen zurückholen.";
"CL Download Management" = "Download-Verwaltung – Alle Downloads sortiert nach Grösse, Datum oder Podcast anzeigen. Einzeln oder pro Podcast löschbar. Unter Einstellungen > Daten > Heruntergeladene Episoden.";
"CL Configurable Swipe Actions" = "Konfigurierbare Wisch-Aktionen – Festlegen, was Wischen nach links oder rechts auf einer Episode bewirkt: als gehört markieren, Favorit, Download, zu Play Next, löschen oder Info anzeigen.";
"CL Tap on Episode" = "Tippen auf Episode – Wählen, ob Tippen auf eine Episode diese direkt abspielt oder die Shownotes öffnet. Einstellungen > Wiedergabe.";
"CL Context Menus" = "Kontextmenüs – Langes Drücken auf Episoden zeigt ein Kontextmenü mit Vorschau, inkl. als gehört/ungehört markieren.";
"CL Adjustable Font Size" = "Einstellbare Schriftgrösse – Vier Stufen (Normal, Grösser, Noch grösser, Am grössten), gilt für die gesamte App. Einstellungen > Darstellung.";
"CL Auto Refresh" = "Podcast-Refresh bei App-Start – Podcasts können automatisch aktualisiert werden, wenn InstacastPlus geöffnet oder wieder in den Vordergrund geholt wird.";
"CL Playback State Markers" = "Abspiel-Markierungen – Gespielte und ungespielte Folgen sind in Listen und auf der Apple Watch klarer erkennbar.";
"CL Faster Refresh" = "Schnellere Aktualisierung – Mehrere Podcasts werden gleichzeitig aktualisiert. Nicht erreichbare Podcasts blockieren die anderen nicht mehr. Klare Timeout-Meldungen.";
"CL Remember Scroll Position" = "Scroll-Position merken – Die Position wird beim Verlassen langer Episodenlisten gespeichert.";
"CL Faster App Start" = "Schnellerer App-Start – Spürbar schnellerer Start.";
"CL Custom Colors" = "Eigene Farben – Eigene Interface-Akzentfarbe festlegen. Player-Farbe passt sich dem Podcast-Artwork an oder kann manuell gewählt werden.";
"CL App Icons" = "App-Icons – Neue Icon-Varianten inklusive Dark- und Tinted-Versionen stehen zur Auswahl.";
"CL Playback Speeds" = "Wiedergabegeschwindigkeiten – 0.5x bis 3x in feinen Stufen. Unter Einstellungen > Wiedergabe > Aktivierte Geschwindigkeitsstufen festlegen, welche Stufen im Player erscheinen.";
"CL Dark Mode" = "Dark Mode – Automatisch (System), Hell oder Dunkel. Pure-Black-Modus für OLED-Displays. Optionaler externer Browser für Shownote-Links.";
"CL MQTT Integration" = "MQTT-Integration – Wiedergabestatus, Kapitel, Sleep Timer, Lautstärke und Gerätestatus an deinen MQTT-Broker senden. Fernsteuerung über MQTT. Nur-WLAN-Modus verfügbar.";
