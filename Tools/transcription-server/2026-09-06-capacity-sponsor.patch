+def api_request_class(request: Request) -> str:
+    path = request.url.path
+    if request.method == "DELETE" and (path.startswith("/api/v1/client-requests/") or re.fullmatch(r"/api/v1/episodes/[^/]+/client-request",path)):
+        return "cancel"
+    return "read" if request.method in {"GET","HEAD"} else "submit"
+
