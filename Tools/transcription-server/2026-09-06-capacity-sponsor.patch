+def enforce_api_request_rate(request: Request, token_id: int, client_id: str) -> None:
+    kind = api_request_class(request)
+    if kind == "read":
+        client_limit = config.API_CLIENT_READ_LIMIT_PER_MINUTE
+        token_limit = config.API_TOKEN_RATE_LIMIT_PER_MINUTE
+    elif kind == "cancel":
+        client_limit = config.API_CLIENT_CANCEL_LIMIT_PER_MINUTE
+        token_limit = config.API_TOKEN_CANCEL_LIMIT_PER_MINUTE
+    else:
+        # Write endpoints already enforce their own client/token submission quotas.
+        return
+    rate_limit(f"api_{kind}:client:{client_id}",client_limit,60,detail="too many client " + kind + " requests")
+    rate_limit(f"api_{kind}:token:{token_id}",token_limit,60,detail="too many API " + kind + " requests")
