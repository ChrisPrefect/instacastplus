+        load = os.getloadavg()[0]
+        if free_disk < config.MIN_FREE_DISK_GIB:
+            message = f"Die Server-Verarbeitung pausiert wegen zu wenig freiem Plattenplatz ({free_disk:.1f} GiB)."
+        elif memory < config.MIN_FREE_MEM_GIB:
+            message = f"Die Server-Verarbeitung pausiert wegen zu wenig freiem Arbeitsspeicher ({memory:.1f} GiB)."
+        elif load > config.MAX_LOAD_1M:
+            message = "Die Server-Verarbeitung pausiert wegen hoher Systemlast."
+    except (OSError, ValueError, StopIteration):
+        message = "Die freien Server-Ressourcen konnten nicht zuverlässig geprüft werden."
+    if message:
+        return {"available":False,"code":"resources_unavailable","message":message,"retry_after_seconds":60}
+    return None
