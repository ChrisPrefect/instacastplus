+def transcription_resource_status() -> dict[str, Any] | None:
+    """Resource pressure is distinct from a healthy, normally occupied worker."""
+    message = None
+    try:
+        free_disk = shutil.disk_usage(config.STORAGE_DIR).free / 2**30
+        memory = next(float(line.split()[1]) / 2**20 for line in Path("/proc/meminfo").read_text().splitlines()
