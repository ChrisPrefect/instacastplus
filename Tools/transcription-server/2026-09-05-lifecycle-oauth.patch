+#!/usr/bin/env python3
+"""Deterministic request/claim lifecycle tests on isolated database state."""
+import json
+import unittest
+from unittest.mock import patch
+from pathlib import Path
+import sys
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from queue_admission_regression import AdmissionTests
+from app import main, service, worker
+from app.db import tx
+from fastapi import HTTPException
+from starlette.requests import Request
+
+
+class LifecycleTests(AdmissionTests):
+    def request(self, client='client-a'):
+        return Request({'type': 'http', 'headers': [(b'x-client', client.encode())]})
+
+    def post_request(self, number, request_id, client='client-a', force=False):
+        payload = main.EpisodeRequest(episode_url=f'https://example.org/{number}.mp3', title=str(number),
+            client_duration_seconds=0.0, wait_seconds=0, force=force, client_request_id=request_id)
+        return main.submit_episode(payload, self.request(client), 1)
+
+    def test_cancel_before_create_is_durable_and_idempotent(self):
+        rid='11111111-1111-4111-8111-111111111111'
+        for _ in range(2):
+            response=main.cancel_client_request(rid, self.request(), 1)
