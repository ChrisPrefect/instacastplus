+def prepare_claim_directory(job: dict[str, Any], result_dir: Path, legacy_audio: Path | None = None) -> Path:
+    run_dir = result_dir / "runs" / f"job-{job['id']}-claim-{job['claim_token']}"
+    run_dir.mkdir(parents=True, exist_ok=True)
+    previous_token = job.get("previous_claim_token")
+    previous_run = result_dir / "runs" / (f"job-{job['id']}-claim-{previous_token}" if previous_token else f"job-{job['id']}")
+    if previous_token is None and previous_run.is_dir() and not (previous_run / "audio-checkpoint.json").exists():
+        completed = any(isinstance(value := load_json(path, None), dict) and value.get("status") == "ready"
+                        for path in previous_run.glob("*.json")) or (previous_run / "transcript-raw.json").exists()
+        if completed:
+            # Old workers kept audio at the episode root and are stopped for migration.
+            # A URL alone cannot prove that a new download is the same dynamic-ad variant.
+            if legacy_audio is None or not legacy_audio.is_file() or legacy_audio.stat().st_size <= 0:
+                raise RuntimeError("Legacy checkpoint audio is unavailable; an explicit new request is required.")
+            snapshot_checkpoint_audio(legacy_audio.parent, run_dir, {
+                "name": legacy_audio.name, "sha256": checkpoint_audio_hash(legacy_audio),
+                "audio_bytes": legacy_audio.stat().st_size, "audio_etag": None})
+    snapshot_completed_checkpoints(previous_run, run_dir, legacy=previous_token is None)
+    # Ownership can advance before a process starts. Checkpoint provenance advances
+    # only after the new private directory contains the complete inherited snapshot.
+    with tx() as con:
+        assert_job_claim(con, job=job)
+        con.execute("UPDATE jobs SET checkpoint_claim_token=? WHERE id=?",
+                    (job['claim_token'], job['id']))
+    return run_dir
 
 
