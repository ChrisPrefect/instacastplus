+#!/usr/bin/env python3
+"""Capture Codex's real tool inventory against a local mock; no model inference.
+
+Run under the authenticated service account with its installed CLI:
+python tools/codex_tool_inventory_regression.py --model gpt-5.6-sol
+"""
+import argparse
+import http.server
+import json
+import sys
+import tempfile
+import threading
+from pathlib import Path
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from app.codex_provider import _command, _run, text_only_catalog
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--model', required=True)
+    parser.add_argument('--executable', default='codex')
+    args = parser.parse_args()
+    rc, out, _ = _run([args.executable, '--version'], '', 10)
+    assert rc == 0 and out.strip() == 'codex-cli 0.152.1', 'Unverified CLI version'
+    rc, out, _ = _run([args.executable, 'debug', 'models', '--bundled'], '', 10)
+    assert rc == 0, 'Cannot read installed model catalog'
+    catalog = text_only_catalog(json.loads(out), args.model)
+    inventories = []
+    class Handler(http.server.BaseHTTPRequestHandler):
+        def do_POST(self):
+            payload = json.loads(self.rfile.read(int(self.headers['Content-Length'])))
+            if self.path.endswith('/responses') and payload.get('model') == args.model and 'input' in payload:
+                inventories.append([tool.get('name') or tool.get('type') for tool in payload.get('tools', [])])
+            else:
+                inventories.append(['unexpected_request_shape:' + self.path + ':' + ','.join(payload.keys())])
+            self.send_response(400)
+            self.end_headers()
+            self.wfile.write(b'{"error":{"message":"Inventory captured; no inference"}}')
+        def log_message(self, *args):
+            pass
+    server = http.server.HTTPServer(('127.0.0.1', 0), Handler)
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    try:
+        with tempfile.TemporaryDirectory(prefix='instacast-tool-proof-') as workspace:
+            path = Path(workspace) / 'catalog.json'
+            path.write_text(json.dumps(catalog))
+            instructions = Path(workspace) / 'instructions.md'
+            instructions.write_text('Return only JSON. Do not call tools.')
+            command = _command(args.executable, args.model, str(path), workspace, instructions)
+            command = command[:-1] + ['-c', 'model_provider="inventory"',
+                '-c', 'model_providers.inventory.name="Inventory"',
+                '-c', f'model_providers.inventory.base_url="http://127.0.0.1:{server.server_port}"',
+                '-c', 'model_providers.inventory.wire_api="responses"',
+                '-c', 'model_providers.inventory.requires_openai_auth=false', '-']
+            _run(command, 'Return {}.', 30)
+        assert inventories and all(not tools for tools in inventories), f'Unexpected tools: {inventories}'
+        print(json.dumps({'model': args.model, 'cli': '0.152.1', 'tools': [], 'paid_inference': False}))
+    finally:
+        server.shutdown()
+        server.server_close()
+        thread.join()
+
+
+if __name__ == '__main__':
+    main()
