+    store_client_request(con, client_hash, request_id, episode_id, "active", url_hash)
+    con.execute("UPDATE transcription_requests SET state='superseded',updated_at=? WHERE client_hash=? AND episode_id=? AND request_id LIKE ? AND state='active'",
+                (now_iso(), client_hash, episode_id, 'legacy:%'))
+
+
+def client_request_response(row: Any) -> JSONResponse:
+    reject_terminal_request(row)
+    status = episode_status(row["episode_id"]) if row["episode_id"] is not None else None
+    if not status:
+        raise HTTPException(status_code=404, detail={"code":"request_not_found", "message":"Request has not been bound to an episode.", "retryable":False})
+    response = episode_json_response(status)
+    body = json.loads(response.body)
+    body["client_request"] = client_request_receipt(row)
+    return JSONResponse(status_code=response.status_code, content=body,
+                        headers={"Retry-After":response.headers["Retry-After"]} if "Retry-After" in response.headers else None)
+
+
+def canonical_request_id(value: str) -> str:
+    try:
+        return str(uuid.UUID(value))
+    except (ValueError, AttributeError, TypeError):
+        raise HTTPException(status_code=422, detail={"code":"invalid_request", "message":"Invalid client request UUID.", "retryable":False})
+
+
+@app.get("/api/v1/client-requests/{request_id}")
+def get_client_request(request_id: str, request: Request, token_id: int = Depends(require_api_token)) -> JSONResponse:
+    client_hash = hash_token(request_client_id(request))
+    with connect() as con:
+        row = request_record(con, client_hash, canonical_request_id(request_id))
+    if not row:
+        raise HTTPException(status_code=404, detail={"code":"request_not_found", "message":"Request is unknown.", "retryable":False})
+    return client_request_response(row)
+
+
+@app.delete("/api/v1/client-requests/{request_id}")
+def cancel_client_request(request_id: str, request: Request, token_id: int = Depends(require_api_token)) -> JSONResponse:
+    client_hash = hash_token(request_client_id(request))
+    with queue_admission_transaction() as con:
+        row = cancel_request_interest(con, client_hash, canonical_request_id(request_id))
+        receipt = client_request_receipt(row)
+    return JSONResponse(content={"api_version":"v1", "client_request":receipt})
+
+
