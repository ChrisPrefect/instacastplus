+def checkpoint_audio_hash(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as source:
+        for chunk in iter(lambda: source.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def snapshot_checkpoint_audio(previous: Path, destination: Path, marker: dict[str, Any] | None = None) -> None:
+    marker = marker if marker is not None else load_json(previous / "audio-checkpoint.json", None)
+    if not isinstance(marker, dict):
+        return
+    name = marker.get("name")
+    if not isinstance(name, str) or Path(name).name != name:
+        raise RuntimeError("Audio checkpoint contains an invalid filename.")
+    source = previous / name
+    target = destination / name
+    temporary = target.with_name(target.name + ".snapshot-part")
+    digest = hashlib.sha256()
+    size = 0
+    try:
+        with source.open("rb") as src, temporary.open("wb") as dst:
+            for chunk in iter(lambda: src.read(1024 * 1024), b""):
+                dst.write(chunk)
+                digest.update(chunk)
+                size += len(chunk)
+        if size != marker.get("audio_bytes") or digest.hexdigest() != marker.get("sha256"):
+            raise RuntimeError("Audio checkpoint source changed; cached analysis cannot be reused.")
+        temporary.replace(target)
+        write_json_atomic(destination / "audio-checkpoint.json", marker)
+    except OSError as exc:
+        raise RuntimeError("Audio checkpoint source is unavailable; cached analysis cannot be reused.") from exc
+    finally:
+        temporary.unlink(missing_ok=True)
+
+
+def snapshot_completed_checkpoints(previous: Path, destination: Path, *, legacy: bool = False) -> None:
+    if not previous.is_dir():
+        return
+    snapshot_checkpoint_audio(previous, destination)
+    for path in previous.glob("*.json"):
+        payload = load_json(path, None)
+        if isinstance(payload, dict) and payload.get("status") == "ready" and payload.get("purpose") and isinstance(payload.get("payload"), dict):
+            write_json_atomic(destination / path.name, payload)
+    marker = load_json(previous / "raw-checkpoint.json", None)
+    raw_names = ["transcript-raw" + suffix for suffix in (".json", ".txt", ".srt", ".vtt")]
+    if marker is None and legacy:
+        # Legacy workers are stopped during deployment; validate their completed raw set once.
+        raw = load_json(previous / raw_names[0], None)
+        if has_complete_word_timestamps(raw) and all((previous / name).is_file() and (previous / name).stat().st_size > 0 for name in raw_names):
+            marker = {name: hashlib.sha256((previous / name).read_bytes()).hexdigest() for name in raw_names}
+    if not isinstance(marker, dict):
+        return
+    snapshots = {}
+    for name in raw_names:
+        path = previous / name
+        if not path.is_file():
+            return
+        content = path.read_bytes()
+        if hashlib.sha256(content).hexdigest() != marker.get(name):
+            return
+        snapshots[name] = content
+    if not has_complete_word_timestamps(json.loads(snapshots[raw_names[0]])):
+        return
+    for name, content in snapshots.items():
+        (destination / name).write_bytes(content)
+    write_json_atomic(destination / "raw-checkpoint.json", marker)
+
