+#!/usr/bin/env python3
+"""Provider reset times must not defer cancellation/configuration status reads."""
+import sys
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from app import codex_provider, service
+
+
+class ProviderPollingTests(unittest.TestCase):
+    def status(self, seconds):
+        error = codex_provider.CodexProviderError('quota')
+        error.retry_after_seconds = seconds
+        settings = {'provider': 'openai_codex', 'kimi_model': 'gpt-5.6-sol',
+                    'codex_catalog_path': '/unused-test-catalog.json'}
+        service.invalidate_transcription_provider_status()
+        with patch.object(service, 'get_ai_settings', return_value=settings), \
+             patch.object(codex_provider, 'provider_readiness', side_effect=error):
+            return service.transcription_provider_status()
+
+    def test_weekly_quota_block_keeps_cancellation_polling_responsive(self):
+        status = self.status(7 * 24 * 3600)
+        self.assertFalse(status['available'])
+        self.assertEqual(300, status['retry_after_seconds'])
+
+    def test_near_reset_can_be_checked_earlier(self):
+        status = self.status(60)
+        self.assertFalse(status['available'])
+        self.assertEqual(60, status['retry_after_seconds'])
+
+
+if __name__ == '__main__':
+    unittest.main()
