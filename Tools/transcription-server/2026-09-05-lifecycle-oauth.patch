+            with self.assertRaises(RuntimeError):
+                worker.call_ai_json(7, 'summary', 'test transcript', 'test system', max_tokens=200, heartbeat_job_id=42)
+        self.assertEqual((1000, 100), record.call_args.args[3:5])
+        self.assertIsNone(record.call_args.args[7]['cost_usd'])
+
+
+if __name__ == '__main__':
+    unittest.main()
