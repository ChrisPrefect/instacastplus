@@ -0,0 +1,31 @@
+#!/usr/bin/env python3
+"""Exercise public progress against isolated storage, including old weighted data."""
+import os
+from pathlib import Path
+import sys
+import tempfile
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+with tempfile.TemporaryDirectory(prefix="instacast-progress-") as directory:
+    os.environ["INSTACAST_DB_BACKEND"] = "sqlite"
+    os.environ["INSTACAST_TRANSCRIPT_DB"] = str(Path(directory) / "test.sqlite3")
+    os.environ["INSTACAST_TRANSCRIPT_STORAGE"] = str(Path(directory) / "storage")
+    from app.db import connect, init_db
+    from app.service import ensure_episode, episode_status
+    from app.main import api_schema
+    init_db()
+    count = 0
+    for state, phase in [("queued", "queued"), ("paused", "queued"), ("downloading", "downloading_audio"), ("transcribing", "transcribing"), ("postprocessing", "analyzing"), ("finalizing", "finalizing"), ("canceled", "canceled"), ("failed", "failed")]:
+        for old_progress in (None, 0.0, 0.5, 0.97):
+            with connect() as con:
+                episode_id = ensure_episode(con, f"https://example.invalid/{count}.mp3", title="Progress test")
+                con.execute("UPDATE episodes SET status=?, processing_progress=? WHERE id=?", (state, old_progress, episode_id))
+            response = episode_status(episode_id)
+            assert response["phase"] == phase, response
+            assert response["progress"] is None, f"Invented public percentage for {state}: {response['progress']}"
+            count += 1
+    episode = api_schema(1)["schemas"]["Episode"]
+    active = next(rule for rule in episode["allOf"] if rule["if"]["properties"]["status"].get("enum") == ["queued", "running"])
+    assert active["then"]["properties"]["progress"] == {"type": "null"}
+    print(f"PASS: {count} public phase/legacy-progress combinations and nullable active schema")
