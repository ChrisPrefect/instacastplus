+@contextmanager
+def queue_admission_transaction() -> Iterator[Any]:
+    """Keep count, membership, and enqueue atomic across all API processes."""
+    con = connect()
+    locked = False
+    begun = False
+    lock_name = "instacast-admission:" + hashlib.sha256(config.MYSQL_DATABASE.encode()).hexdigest()[:32]
+    try:
+        if is_mysql():
+            row = con.execute("SELECT GET_LOCK(?, 10) AS acquired", (lock_name,)).fetchone()
+            if not row or row["acquired"] != 1:
+                raise HTTPException(status_code=503, detail={
+                    "code": "queue_unavailable", "message": "Queue admission is busy.", "retryable": True,
+                }, headers={"Retry-After": "30"})
+            locked = True
+        con.execute("BEGIN IMMEDIATE")
+        begun = True
+        yield con
+        con.execute("COMMIT")
+        begun = False
+    except Exception:
+        if begun:
+            con.execute("ROLLBACK")
+        raise
+    finally:
+        try:
+            if locked:
+                con.execute("SELECT RELEASE_LOCK(?)", (lock_name,))
+        finally:
+            con.close()
+
+
+def transcription_worker_status() -> dict[str, bool]:
+    """A configured worker is available only while systemd owns a running process."""
+    states: dict[str, bool] = {}
+    for unit in config.TRANSCRIPTION_WORKER_UNITS:
+        try:
+            result = subprocess.run(
+                ["systemctl", "show", unit, "--property=ActiveState,SubState,MainPID"],
+                capture_output=True, text=True, timeout=2, check=False,
+            )
+            properties = dict(line.split("=", 1) for line in result.stdout.splitlines() if "=" in line)
+            states[unit] = (result.returncode == 0 and properties.get("ActiveState") == "active"
+                            and properties.get("SubState") == "running"
+                            and int(properties.get("MainPID", "0")) > 0)
+        except (OSError, subprocess.TimeoutExpired, ValueError):
+            states[unit] = False
+    return states
+
+
+class TranscriptionProviderUnavailable(RuntimeError):
+    """A provider-wide block must not consume an episode's failure attempts."""
+
+
+_provider_status_lock = threading.Lock()
+_provider_status_cache: dict[str, Any] = {}
+
+
+def provider_unavailable_status(message: str) -> dict[str, Any]:
+    return {"available": False, "code": "provider_unavailable", "message": message, "retry_after_seconds": 300}
+
+
+def invalidate_transcription_provider_status() -> None:
+    with _provider_status_lock:
+        _provider_status_cache.clear()
+
+
+def transcription_provider_status() -> dict[str, Any] | None:
+    settings = get_ai_settings()
+    provider = str(settings["provider"]).lower()
+    if provider in {"", "disabled"} or not settings["kimi_api_key"]:
+        return provider_unavailable_status("Die Server-Verarbeitung wartet auf die Konfiguration des AI-Dienstes.")
+    if ai_monthly_spend() >= float(settings["monthly_limit_usd"]):
+        return provider_unavailable_status("Die Server-Verarbeitung pausiert, weil das AI-Monatsbudget ausgeschöpft ist.")
+    if provider != "deepseek":
+        return None
+    base_url = str(settings["kimi_base_url"]).rstrip("/")
+    key = (provider, base_url, hashlib.sha256(str(settings["kimi_api_key"]).encode()).hexdigest())
+    with _provider_status_lock:
+        if _provider_status_cache.get("key") == key and _provider_status_cache.get("expires", 0) > time.monotonic():
+            return _provider_status_cache["status"]
+        try:
+            # /v1 is an optional OpenAI-compatible prefix; balance is account-level.
+            balance_base = base_url[:-3] if base_url.endswith("/v1") else base_url
+            with guarded_get(balance_base + "/user/balance", purpose="AI balance", timeout=(3, 5),
