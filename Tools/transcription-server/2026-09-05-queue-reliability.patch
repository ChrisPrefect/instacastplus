+from app import config, main, service
+from app import worker
+from app.db import init_db, tx
+from fastapi import HTTPException
+from starlette.requests import Request
+
+
+class AdmissionTests(unittest.TestCase):
+    def setUp(self):
+        self.contexts = ExitStack()
+        self.addCleanup(self.contexts.close)
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        root = Path(self.temp.name)
+        for key, value in dict(ROOT=root, VAR_DIR=root / 'var', DB_PATH=root / 'test.sqlite',
+                               STORAGE_DIR=root / 'storage', DB_BACKEND='sqlite',
+                               MAX_QUEUED_TRANSCRIBE_JOBS=75,
+                               MAX_CLIENT_ACTIVE_TRANSCRIBE_JOBS=25).items():
+            self.contexts.enter_context(patch.object(config, key, value, create=True))
+        init_db()
+        self.contexts.enter_context(patch.object(main, 'transcription_provider_status', return_value=None, create=True))
+        self.workers = self.contexts.enter_context(patch.object(main, 'transcription_worker_status',
+            return_value={'worker': True}, create=True))
+        self.contexts.enter_context(patch.object(main, 'note_api_client', side_effect=lambda request, client: client))
+        self.contexts.enter_context(patch.object(main, 'request_client_id', side_effect=lambda request: request.headers['x-client']))
+        self.contexts.enter_context(patch.object(main, 'enforce_submit_limit'))
+        self.contexts.enter_context(patch.object(main, 'validate_public_url'))
+
+    def submit(self, number, client='client-a'):
+        request = Request({'type': 'http', 'method': 'POST', 'path': '/api/v1/episodes',
