+                             max_redirects=0) as response:
+                response.raise_for_status()
+                payload = response.json()
+                if payload.get("is_available") is True:
+                    status = None
+                elif payload.get("is_available") is False:
+                    status = provider_unavailable_status("Die Server-Verarbeitung pausiert, weil das DeepSeek-Guthaben aufgebraucht ist. Der Serverbetreiber muss das Guthaben aufladen.")
+                else:
+                    status = provider_unavailable_status("Die Verfügbarkeit des AI-Dienstes konnte nicht bestätigt werden.")
+        except (requests.RequestException, HTTPException, ValueError, AttributeError):
+            status = provider_unavailable_status("Die Verfügbarkeit des AI-Dienstes konnte nicht bestätigt werden.")
+        _provider_status_cache.update(key=key, expires=time.monotonic() + 30, status=status)
+        return status
 
 
