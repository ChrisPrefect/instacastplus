@@ -0,0 +1,186 @@
+#!/usr/bin/env python3
+"""Explicit server-source HTTP admission and real worker download, with no inference."""
+import hashlib
+import io
+import json
+import os
+from pathlib import Path
+import sys
+import threading
+import unittest
+import wave
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from unittest.mock import patch
+sys.path.insert(0,str(Path(__file__).resolve().parent))
+import queue_admission_regression as admission
+from app import config,main,service,worker
+from app.db import tx,init_db
+from app.security import hash_token
+from fastapi.testclient import TestClient
+
+ROOT=Path(__file__).resolve().parents[1]
+RID='11111111-1111-4111-8111-111111111111'
+RID2='22222222-2222-4222-8222-222222222222'
+
+class ASRReached(Exception):pass
+
+class ServerAudioSourceTests(unittest.TestCase):
+    def setUp(self):
+        admission.AdmissionTests.setUp(self)
+        self.contexts.enter_context(patch.object(main,'transcription_resource_status',return_value=None))
+        self.contexts.enter_context(patch.object(worker,'transcription_resource_status',return_value=None))
+        self.contexts.enter_context(patch.object(worker,'transcription_provider_status',return_value=None))
+        self.contexts.enter_context(patch.object(worker,'transcribe_block_reason',return_value=None))
+        self.contexts.enter_context(patch.object(config,'ROOT',ROOT))
+        self.contexts.enter_context(patch.object(worker,'PYTHON',Path(sys.executable)))
+        main.app.dependency_overrides[main.require_api_token]=lambda:1
+        self.addCleanup(main.app.dependency_overrides.clear)
+        self.client=TestClient(main.app)
+        self.url='https://example.org/audio.wav'
+
+    def post(self,mode='server',sha=None,rid=RID,client='client-a'):
+        data={'episode_url':self.url,'title':'Server source fixture','client_duration_seconds':0.0,
+              'wait_seconds':0,'force':False}
+        if mode is not None:data['audio_source']=mode
+        if sha is not None:data['client_audio_sha256']=sha
+        if rid is not None:data['client_request_id']=rid
+        result=self.client.post('/api/v1/episodes',json=data,headers={'x-client':client})
+        if evidence:=os.environ.get('SERVER_SOURCE_EVIDENCE'):
+            with Path(evidence).open('a') as output:
+                output.write(json.dumps({'test':self.id(),'request':data,'status':result.status_code,'response':result.json()})+'\n')
+        return result
+
+    def admitted(self,**kwargs):
+        response=self.post(**kwargs)
+        self.assertEqual(202,response.status_code,response.text)
+        return response.json()['episode']['id']
+
+    def request_row(self,client='client-a',rid=RID):
+        with tx() as con:return dict(service.request_record(con,hash_token(client),rid))
+
+    def test_no_device_audio_is_admitted_and_replayed(self):
+        episode=self.admitted()
+        self.assertEqual('server',self.request_row()['audio_source'])
+        self.assertIsNone(self.request_row()['audio_sha256'])
+        again=self.post()
+        self.assertEqual(202,again.status_code,again.text)
+        self.assertEqual(episode,again.json()['episode']['id'])
+        self.assertEqual('server',again.json()['client_request']['audio_source'])
+        with tx() as con:self.assertEqual(1,con.execute('SELECT COUNT(*) AS n FROM jobs').fetchone()['n'])
+
+    def test_public_schema_describes_source_receipt(self):
+        schema=self.client.get('/api/v1/schema').json()
+        props=schema['schemas']['EpisodeEnvelope']['properties']
+        self.assertIn('client_request',props,'The receipt carrying immutable source selection must be part of the public response contract')
+        receipt=schema['schemas']['ClientRequestReceipt']
+        self.assertEqual({'client','server'},set(receipt['properties']['audio_source']['enum']))
+        self.assertEqual({'client','server'},set(schema['schemas']['SubmitEpisodeRequest']['properties']['audio_source']['enum']))
+
+    def test_client_mode_still_requires_hash(self):
+        for mode in [None,'client']:
+            response=self.post(mode=mode)
+            self.assertEqual(422,response.status_code,response.text)
+            self.assertEqual('audio_identity_required',response.json()['error']['code'])
+        with tx() as con:self.assertEqual(0,con.execute('SELECT COUNT(*) AS n FROM jobs').fetchone()['n'])
+
+    def test_explicit_source_contract_rejects_ambiguity(self):
+        for options in [{'mode':'upload'},{'sha':'a'*64},{'rid':None}]:
+            response=self.post(**options)
+            self.assertEqual(422,response.status_code,response.text)
+        with tx() as con:self.assertEqual(0,con.execute('SELECT COUNT(*) AS n FROM jobs').fetchone()['n'])
+
+    def test_uuid_source_mode_is_immutable_both_directions(self):
+        self.admitted()
+        changed=self.post(mode='client',sha='a'*64)
+        self.assertEqual(409,changed.status_code,changed.text)
+        self.assertEqual('request_conflict',changed.json()['error']['code'])
+        self.admitted(mode='client',sha='a'*64,rid=RID2,client='client-b')
+        changed=self.post(rid=RID2,client='client-b')
+        self.assertEqual(409,changed.status_code,changed.text)
+        self.assertEqual('request_conflict',changed.json()['error']['code'])
+
+    def test_first_server_hash_binding_is_durable_and_replay_stays_hashless(self):
+        episode=self.admitted()
+        with tx() as con:self.assertTrue(service.verify_requested_audio(con,episode,'a'*64))
+        self.assertEqual('a'*64,self.request_row()['audio_sha256'])
+        self.assertEqual(202,self.post().status_code)
+        with tx() as con:self.assertFalse(service.verify_requested_audio(con,episode,'b'*64))
+        self.assertEqual('a'*64,self.request_row()['audio_sha256'])
+        response=self.client.get('/api/v1/client-requests/'+RID,headers={'x-client':'client-a'})
+        self.assertEqual(409,response.status_code,response.text)
+        self.assertEqual('audio_source_mismatch',response.json()['error']['code'])
+
+    def test_shared_work_rejects_client_mismatch_only(self):
+        episode=self.admitted()
+        self.admitted(mode='client',sha='b'*64,rid=RID2,client='client-b')
+        with tx() as con:self.assertTrue(service.verify_requested_audio(con,episode,'a'*64))
+        self.assertEqual('active',self.request_row()['state'])
+        self.assertEqual('audio_mismatch',self.request_row('client-b',RID2)['state'])
+        self.assertEqual('a'*64,self.request_row()['audio_sha256'])
+
+    def test_late_server_join_binds_known_worker_source(self):
+        episode=self.admitted(mode='client',sha='a'*64)
+        with tx() as con:con.execute('UPDATE jobs SET verified_audio_sha256=? WHERE episode_id=?',('a'*64,episode))
+        self.admitted(rid=RID2,client='client-b')
+        self.assertEqual('a'*64,self.request_row('client-b',RID2)['audio_sha256'])
+        self.assertEqual('active',self.request_row('client-b',RID2)['state'])
+
+    def test_cancellation_blocks_server_replay(self):
+        response=self.client.delete('/api/v1/client-requests/'+RID,headers={'x-client':'client-a'})
+        self.assertEqual(200,response.status_code,response.text)
+        response=self.post()
+        self.assertEqual(410,response.status_code,response.text)
+        self.assertEqual('request_canceled',response.json()['error']['code'])
+
+    def test_real_worker_download_binds_server_source_before_asr(self):
+        data=io.BytesIO()
+        with wave.open(data,'wb') as wav:
+            wav.setnchannels(1);wav.setsampwidth(2);wav.setframerate(16000);wav.writeframes(b'\x00\x00'*16000)
+        audio=data.getvalue();observed=[]
+        class Source(BaseHTTPRequestHandler):
+            def do_GET(self):
+                observed.append(self.path)
+                self.send_response(200);self.send_header('Content-Length',str(len(audio)));self.end_headers();self.wfile.write(audio)
+            def log_message(self,*args):pass
+        source=ThreadingHTTPServer(('127.0.0.1',0),Source)
+        threading.Thread(target=source.serve_forever,daemon=True).start()
+        self.addCleanup(source.server_close);self.addCleanup(source.shutdown)
+        self.url=f'http://127.0.0.1:{source.server_port}/audio.wav'
+        episode=self.admitted()
+        self.assertEqual([],observed,'Submitting a URL must not download audio in the API/client')
+        job=worker.claim_job('server-source-proof')
+        # Only loopback address validation and the expensive inference invocation are controlled.
+        with worker.job_claim(job),patch.object(worker,'guarded_get',side_effect=lambda url,**kw:worker.requests.get(url,stream=True,timeout=5)), \
+             patch.object(worker,'run_command',side_effect=ASRReached) as asr:
+            with self.assertRaises(ASRReached):worker.run_transcribe(job,{'source':'api_episode'})
+        self.assertEqual(['/audio.wav'],observed)
+        self.assertEqual(hashlib.sha256(audio).hexdigest(),self.request_row()['audio_sha256'])
+        self.assertEqual('active',self.request_row()['state'])
+        self.assertEqual(1,asr.call_count)
+        with tx() as con:
+            row=dict(con.execute('SELECT * FROM episodes WHERE id=?',(episode,)).fetchone())
+        self.assertEqual(1.0,row['detected_duration_seconds'])
+        self.assertEqual(hashlib.sha256(audio).hexdigest(),row['audio_sha256'])
+        self.assertEqual('transcribing',row['status'])
+        # A new worker must resume the selected source even if its public URL now changes.
+        audio=b'changed publisher bytes that must not be downloaded'
+        with tx() as con:con.execute("UPDATE jobs SET status='queued' WHERE id=?",(job['id'],))
+        resumed=worker.claim_job('server-source-resume-proof')
+        self.assertNotEqual(job['claim_token'],resumed['claim_token'])
+        with worker.job_claim(resumed),patch.object(worker,'guarded_get',side_effect=lambda url,**kw:worker.requests.get(url,stream=True,timeout=5)), \
+             patch.object(worker,'run_command',side_effect=ASRReached):
+            with self.assertRaises(ASRReached):worker.run_transcribe(resumed,{'source':'api_episode'})
+        self.assertEqual(['/audio.wav'],observed,'Resume must keep the first server source')
+        self.assertEqual(row['audio_sha256'],self.request_row()['audio_sha256'])
+        self.assertEqual(202,self.post().status_code)
+
+    def test_additive_migration_defaults_existing_requests_to_client(self):
+        self.admitted(mode='client',sha='a'*64)
+        with tx() as con:con.execute('ALTER TABLE transcription_requests DROP COLUMN audio_source')
+        init_db()
+        row=self.request_row()
+        self.assertEqual('client',row['audio_source'])
+        self.assertEqual('a'*64,row['audio_sha256'])
+        self.assertEqual(202,self.post(mode='client',sha='a'*64).status_code)
+
+if __name__=='__main__':unittest.main(verbosity=2)
