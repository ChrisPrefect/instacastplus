+        if requested_hash:
+            expected_hashes = {row["audio_sha256"] for row in con.execute("""SELECT DISTINCT audio_sha256
+                FROM transcription_requests WHERE episode_id=? AND state='active' AND audio_sha256 IS NOT NULL""",
+                (candidate["id"],)).fetchall()}
+            known_hashes = {job["verified_audio_sha256"]} if job["verified_audio_sha256"] else expected_hashes
+            if known_hashes and requested_hash not in known_hashes:
+                incompatible_pending = True
+                continue
+        return candidate
+    changed_source = bool(requested_hash and (incompatible_pending or
