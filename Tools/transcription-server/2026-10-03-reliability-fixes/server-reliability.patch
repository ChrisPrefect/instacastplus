+            if (candidate["status"] == "ready" and candidate["audio_sha256"] == requested_hash
+                    and has_required_client_artifacts(con, int(candidate["id"]))):
+                return candidate
+    incompatible_pending = False
+    for candidate in candidates:
+        job = con.execute("""SELECT verified_audio_sha256 FROM jobs WHERE episode_id=? AND job_type='transcribe'
+            AND status IN ('queued','running','paused') ORDER BY id DESC LIMIT 1""", (candidate["id"],)).fetchone()
+        if not job:
