+def ensure_sqlite_source_generations(con: Any) -> None:
+    # SQLite cannot drop an inline UNIQUE constraint. Rebuild only that table,
+    # preserving IDs, referencing tables, explicit indexes and triggers atomically.
+    con.execute("PRAGMA foreign_keys=OFF")
+    con.execute("BEGIN IMMEDIATE")
+    try:
+        schema = con.execute("SELECT sql FROM sqlite_master WHERE type='table' AND name='episodes'").fetchone()["sql"]
+        if re.search(r"episode_url\s+TEXT\s+NOT\s+NULL\s+UNIQUE", schema, re.I):
+            definitions = con.execute("SELECT sql FROM sqlite_master WHERE tbl_name='episodes' AND type IN ('index','trigger') AND sql IS NOT NULL").fetchall()
+            replacement = re.sub(r"episode_url\s+TEXT\s+NOT\s+NULL\s+UNIQUE", "episode_url TEXT NOT NULL", schema, count=1, flags=re.I)
+            replacement = re.sub(r"CREATE TABLE\s+episodes", "CREATE TABLE episodes_source_generation_migration", replacement, count=1, flags=re.I)
+            con.execute(replacement)
+            con.execute("INSERT INTO episodes_source_generation_migration SELECT * FROM episodes")
+            con.execute("DROP TABLE episodes")
+            con.execute("ALTER TABLE episodes_source_generation_migration RENAME TO episodes")
+            for row in definitions:
+                con.execute(row["sql"])
+        con.execute("CREATE UNIQUE INDEX IF NOT EXISTS uniq_episodes_source_generation ON episodes(episode_url,source_generation)")
+        if con.execute("PRAGMA foreign_key_check").fetchone():
+            raise RuntimeError("Source generation migration violates existing references.")
+        con.execute("COMMIT")
+    except Exception:
+        con.execute("ROLLBACK")
+        raise
+    finally:
+        con.execute("PRAGMA foreign_keys=ON")
 
 
