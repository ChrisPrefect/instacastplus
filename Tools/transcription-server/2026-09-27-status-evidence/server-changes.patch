+#!/usr/bin/env python3
+"""Real API admission + durable DB identity, controlled publisher/provider boundaries."""
+import concurrent.futures
+import json
+from pathlib import Path
+import sys
+import threading
+import time
+import unittest
+from unittest.mock import patch
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from queue_admission_regression import AdmissionTests
+from app import main
+from app.db import connect
+from fastapi.testclient import TestClient
+
+
+class AdmissionLatencyTests(AdmissionTests):
+    def test_live_worker_progress_is_not_hidden_by_unrelated_provider_outage(self):
+        observed = {'status':'running', 'phase':'transcribing', 'work':{'activity':'running'}}
+        with patch.object(main, 'transcription_provider_status', return_value={
+                'available':False, 'code':'provider_unavailable', 'retry_after_seconds':300}) as provider:
+            envelope = main.episode_envelope(observed)
+        self.assertNotIn('service_status', envelope,
+                         'Actual ASR work was falsely presented as paused by an unrelated text-provider check')
+        provider.assert_not_called()
+
+    def test_schema_describes_measured_phase_work(self):
+        schema = main.api_schema(1)
+        work = schema['schemas']['Episode']['properties'].get('work')
+        self.assertIsNotNone(work, 'Public schema must expose measured phase work')
+        self.assertIn('estimated_phase_remaining_seconds', work['properties'])
+        self.assertIn('recovering', work['properties']['activity']['enum'])
+
+    def test_episode_admission_does_not_wait_for_publisher_feed(self):
+        entered, release = threading.Event(), threading.Event()
+        def blocked_feed(url):
+            entered.set()
+            release.wait(3)
+            return {'feed_url': url, 'title': 'Publisher', 'episodes': []}
+        main.app.dependency_overrides[main.require_api_token] = lambda: 1
+        self.addCleanup(main.app.dependency_overrides.clear)
+        request_id = 'cbbd954f-2a4a-4f3a-a882-e93d5a4a2172'
+        body = dict(episode_url='https://example.org/audio.mp3',
+                    podcast_url='https://example.org/feed.xml', title='Already in the app',
+                    client_audio_sha256='a'*64, client_duration_seconds=120,
+                    wait_seconds=0, client_request_id=request_id, force=False)
+        with patch.object(main, 'fetch_feed', side_effect=blocked_feed), \
+             patch.object(main, 'transcription_resource_status', return_value=None), \
+             TestClient(main.app) as client, \
+             concurrent.futures.ThreadPoolExecutor(max_workers=1) as pool:
+            started = time.monotonic()
+            future = pool.submit(client.post, '/api/v1/episodes', json=body,
+                                 headers={'x-client': 'admission-latency-test'})
+            try:
+                response = future.result(timeout=1)
