+        self.assertEqual(60,state.get('completed_audio_seconds'),'In-flight first-pass segments are not final ASR completion')
+        self.assertEqual(100,state['total_audio_seconds'])
+
+
+if __name__=='__main__':
+    unittest.main(defaultTest='WorkStatusTests', verbosity=2)
