+#!/usr/bin/env python3
+"""HTTP/queue/worker measurement contract on disposable state, without inference."""
+import json
+import math
+import os
+from pathlib import Path
+import sys
+import threading
+import time
+import unittest
+from datetime import datetime, timedelta, timezone
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from unittest.mock import patch
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from queue_admission_regression import AdmissionTests
+from app import config, main, service, worker
+from app.db import tx, now_iso, init_db
+from fastapi.testclient import TestClient
+import transcribe_podcast_parallel as parallel
+
+
+class WorkStatusTests(unittest.TestCase):
+    seed = AdmissionTests.seed
+
+    def setUp(self):
+        AdmissionTests.setUp(self)
+        self.contexts.enter_context(patch.object(main, 'transcription_resource_status', return_value=None))
+        main.app.dependency_overrides[main.require_api_token] = lambda: 1
+        self.addCleanup(main.app.dependency_overrides.clear)
+        self.client = TestClient(main.app)
+        self.contexts.enter_context(patch.object(worker, 'transcription_provider_status', return_value=None))
+        self.contexts.enter_context(patch.object(worker, 'transcribe_block_reason', return_value=None))
+        self.contexts.enter_context(patch.object(worker, 'transcription_resource_status', return_value=None))
+
+    def claim(self):
+        self.seed(1)
+        return worker.claim_job('progress-proof')
+
+    def response(self, episode):
+        response = self.client.get(f'/api/v1/episodes/{episode}', headers={'x-client':'client-a'})
+        self.assertEqual(response.status_code, 200, response.text)
+        result = response.json()['episode']
+        self.assertIn('work', result, 'No observable worker activity/measurement in accepted HTTP response')
+        if evidence := os.environ.get('WORK_STATUS_EVIDENCE'):
+            with Path(evidence).open('a') as output:
+                output.write(json.dumps({'test':self.id(),'episode':result})+'\n')
+        return result
+
+    def measured(self, job, completed, total, unit='audio_seconds', phase='transcribing'):
+        with worker.job_claim(job):
+            worker.set_episode_progress(job['episode_id'], phase, None,
+                measurement={'completed':completed, 'total':total, 'unit':unit})
+
+    def test_http_queue_acceptance_claim_and_phase(self):
+        self.seed(2)
+        result = self.response(2)
+        self.assertEqual('queued', result['work']['activity'])
+        self.assertEqual(2, result['work']['queue_position'])
+        self.assertIsNone(result['work']['updated_at'])
+        job = worker.claim_job('progress-proof')
+        result = self.response(job['episode_id'])
+        self.assertEqual('running', result['work']['activity'])
+        with worker.job_claim(job):
+            worker.set_episode_status(job['episode_id'], 'postprocessing')
+            worker.touch_job(job['id'])
+        result = self.response(job['episode_id'])
+        self.assertEqual('analyzing', result['work']['phase'])
+        self.assertEqual(result['phase'], result['work']['phase'])
+        self.assertIsNone(result['progress'])
+        self.assertIsNone(result['work']['total'])
+
+    def test_current_phase_throughput_and_phase_reset(self):
+        job = self.claim()
+        now = datetime.now(timezone.utc)
+        with patch.object(worker, 'now_iso', return_value=(now-timedelta(seconds=20)).isoformat()):
+            self.measured(job, 100, 600)
+        self.assertIsNone(self.response(job['episode_id'])['work']['estimated_phase_remaining_seconds'])
+        with patch.object(worker, 'now_iso', return_value=(now-timedelta(seconds=10)).isoformat()):
+            self.measured(job, 200, 600)
+        work = self.response(job['episode_id'])['work']
+        self.assertEqual((200,600,'audio_seconds'),(work['completed'],work['total'],work['unit']))
+        self.assertEqual(40, work['estimated_phase_remaining_seconds'])
+        with worker.job_claim(job):
+            worker.set_episode_status(job['episode_id'], 'postprocessing')
+        work = self.response(job['episode_id'])['work']
+        self.assertIsNone(work['total'])
+        self.assertIsNone(work['estimated_phase_remaining_seconds'])
+
+    def test_stale_activity_is_not_refreshed_by_episode_write(self):
+        job = self.claim()
+        old = (datetime.now(timezone.utc)-timedelta(seconds=40)).isoformat()
+        with patch.object(worker, 'now_iso', return_value=old):
+            self.measured(job, 100, 600)
+        with tx() as con:
+            con.execute('UPDATE jobs SET updated_at=? WHERE id=?',(old,job['id']))
+            con.execute('UPDATE episodes SET updated_at=? WHERE id=?',(now_iso(),job['episode_id']))
+        work = self.response(job['episode_id'])['work']
+        self.assertEqual('recovering',work['activity'])
+        self.assertEqual(old,work['updated_at'])
+        self.assertIsNone(work['estimated_phase_remaining_seconds'])
+
+    def test_retry_and_pause_are_not_running(self):
+        job = self.claim()
+        for state, expected in [('paused','paused'),('queued','retrying'),('canceled','stopped'),('failed','stopped')]:
+            with tx() as con:
+                con.execute('UPDATE jobs SET status=?,next_attempt_at=? WHERE id=?',
+                            (state,worker.future_iso(60),job['id']))
+            work = self.response(job['episode_id'])['work']
+            self.assertEqual(expected,work['activity'])
+            self.assertIsNone(work['estimated_phase_remaining_seconds'])
+
+    def test_new_claim_rejects_old_measurements(self):
+        job = self.claim()
+        self.measured(job, 200, 600)
+        with tx() as con:
+            con.execute("UPDATE jobs SET status='queued' WHERE id=?",(job['id'],))
+        next_job = worker.claim_job('successor')
+        self.assertEqual(job['id'],next_job['id'])
+        self.assertNotEqual(job['claim_token'],next_job['claim_token'])
+        work = self.response(job['episode_id'])['work']
+        self.assertIsNone(work['completed'])
+        with self.assertRaises(worker.JobClaimLost):
+            self.measured(job, 300, 600)
+        self.measured(next_job, 200, 600)
+        self.assertIsNone(self.response(job['episode_id'])['work']['estimated_phase_remaining_seconds'])
+
+    def test_invalid_counts_cannot_be_published(self):
+        job = self.claim()
+        for completed,total in [(math.nan,100),(-1,100),(101,100),(10,0),(True,100),(10,math.inf)]:
+            with self.subTest(completed=completed,total=total):
+                self.measured(job,completed,total)
+                work = self.response(job['episode_id'])['work']
+                self.assertIsNone(work['completed'])
+                self.assertIsNone(work['estimated_phase_remaining_seconds'])
+
+    def test_real_download_child_publishes_counts(self):
+        job = self.claim()
+        payload = b'a' * (2*1024*1024+71)
+        class Source(BaseHTTPRequestHandler):
+            def do_GET(self):
+                self.send_response(200);self.send_header('Content-Length',str(len(payload)));self.end_headers()
+                self.wfile.write(payload)
+            def log_message(self,*args): pass
+        source=ThreadingHTTPServer(('127.0.0.1',0),Source)
+        thread=threading.Thread(target=source.serve_forever,daemon=True);thread.start()
+        self.addCleanup(source.server_close);self.addCleanup(source.shutdown)
+        # Only outbound address validation is replaced for the loopback test source.
+        with worker.job_claim(job), patch.object(worker,'guarded_get',side_effect=lambda url,**kw:worker.requests.get(url,stream=True,timeout=5)):
+            path,_=worker.download_audio(f'http://127.0.0.1:{source.server_port}/audio',Path(self.temp.name)/'download.wav',
+                                        episode_id=job['episode_id'],heartbeat_job_id=job['id'])
+        self.assertEqual(payload,path.read_bytes())
+        work=self.response(job['episode_id'])['work']
+        self.assertEqual(('bytes',len(payload),len(payload)),(work['unit'],work['completed'],work['total']))
+
+    def test_healthy_http_poll_interval_and_capacity_budget(self):
+        job=self.claim()
+        response=self.client.get(f'/api/v1/episodes/{job["episode_id"]}',headers={'x-client':'client-a'})
+        interval=response.json()['retry_after_seconds']
+        self.assertGreater(interval,0)
+        self.assertLessEqual(interval,5,'Healthy work must be observable without a 15-second UI lag')
+        schema=self.client.get('/api/v1/schema').json()
+        reads=math.ceil(60/interval)+6
+        rates=schema['rate_limit_contract']['read_requests_per_minute']
+        self.assertGreaterEqual(rates['client'],25*reads)
+        self.assertGreaterEqual(rates['ip'],250*reads)
+        self.assertGreaterEqual(rates['token'],rates['ip'])
+        with tx() as con:
+            receipt=dict(con.execute('SELECT * FROM transcription_requests WHERE episode_id=?',(job['episode_id'],)).fetchone())
+        accepted=main.client_request_response(receipt)
+        self.assertLessEqual(int(accepted.headers['Retry-After']),5)
+        paused={'available':False,'code':'provider_unavailable','message':'unavailable','retry_after_seconds':300}
+        with tx() as con:
+            con.execute("UPDATE jobs SET status='paused' WHERE id=?",(job['id'],))
+        with patch.object(main,'transcription_provider_status',return_value=paused):
+            response=self.client.get(f'/api/v1/episodes/{job["episode_id"]}',headers={'x-client':'client-a'})
+        self.assertEqual(300,response.json()['retry_after_seconds'])
+
+    def test_subprocess_supervisor_reads_real_asr_progress_file(self):
+        job = self.claim()
+        root=Path(self.temp.name)
+        progress=root/'progress.json'
+        code="import json,time;from pathlib import Path;Path("+repr(str(progress))+").write_text(json.dumps({'completed_audio_seconds':60,'total_audio_seconds':100,'progress':0.7}));time.sleep(10.5)"
+        with worker.job_claim(job):
+            worker.set_episode_status(job['episode_id'],'transcribing')
+            worker.run_command([sys.executable,'-c',code],root/'worker.log',cwd=root,
+                               heartbeat_job_id=job['id'],episode_id=job['episode_id'],progress_path=progress)
+        work=self.response(job['episode_id'])['work']
+        self.assertEqual((60,100,'audio_seconds'),(work['completed'],work['total'],work['unit']))
+        self.assertEqual('running',work['activity'])
+
+    def test_additive_migration_keeps_existing_job(self):
+        self.seed(1)
+        with tx() as con:
+            before=dict(con.execute('SELECT * FROM jobs').fetchone())
+            con.execute('ALTER TABLE jobs DROP COLUMN work_json')
+        init_db()
+        with tx() as con:
+            after=dict(con.execute('SELECT * FROM jobs').fetchone())
+        self.assertIsNone(after['work_json'])
+        self.assertEqual({key:value for key,value in before.items() if key!='work_json'},
+                         {key:value for key,value in after.items() if key!='work_json'})
+        job=worker.claim_job('after-migration')
+        self.measured(job,100,200,'bytes','downloading')
+        self.assertEqual(100,self.response(job['episode_id'])['work']['completed'])
+
+    def test_provider_authentication_is_product_message_in_http(self):
+        from app.codex_provider import CodexProviderError
+        self.seed(1)
+        settings = {'provider':'openai_codex','kimi_model':'test-model','codex_catalog_path':'fixture'}
+        with patch.object(service, 'get_ai_settings', return_value=settings), \
+             patch('app.codex_provider.provider_readiness', side_effect=CodexProviderError('authentication','fixture login required')), \
+             patch.object(main, 'transcription_provider_status', side_effect=service.transcription_provider_status):
+            service.invalidate_transcription_provider_status()
+            response = self.client.get('/api/v1/episodes/1',headers={'x-client':'client-a'}).json()
+        status=response['service_status']
+        self.assertEqual('provider_unavailable', status['code'])
+        self.assertEqual('provider_authentication', status.get('reason_code'))
+        self.assertEqual('Die Server-Transkription ist momentan nicht verfügbar.', status['message'])
+
+    def test_budget_configuration_is_not_a_customer_action(self):
+        settings = {'provider':'deepseek','kimi_model':'fixture','kimi_api_key':'fixture','kimi_base_url':'https://invalid.test',
+                    'codex_catalog_path':'fixture','monthly_limit_usd':1}
+        block={'available':False,'code':'provider_unavailable','message':'Increase the operator budget', 'retry_after_seconds':300}
+        with patch.object(service,'get_ai_settings',return_value=settings), \
+             patch('app.settings.api_budget_block', return_value=block):
+            status = service.transcription_provider_status()
+        self.assertEqual('provider_budget',status.get('reason_code'))
+        self.assertEqual('Die Server-Transkription ist momentan nicht verfügbar.',status['message'])
+
+    def test_runtime_provider_diagnostics_stay_private(self):
+        settings = {'provider':'openai_codex','kimi_model':'test-model','codex_catalog_path':'fixture'}
+        service.block_transcription_provider(settings, 'Internal fixture credential invalid; contact operator')
+        status = service.transcription_provider_runtime_status(settings)
+        self.assertEqual('Die Server-Transkription ist momentan nicht verfügbar.', status['message'])
+        self.assertEqual('provider_runtime_failure', status.get('reason_code'))
+        self.assertIn('credential',service.get_setting('transcription_provider_block',''))
+
+    def test_asr_counts_only_finished_chunks_without_context(self):
+        root=Path(self.temp.name)
+        chunks=[{'index':0,'duration':60,'progress_path':root/'first.json'},
+                {'index':1,'duration':40,'progress_path':root/'second.json'}]
+        (root/'first.json').write_text('{"progress":1}')
+        (root/'second.json').write_text('{"progress":0.9}')
