@@ -0,0 +1,49 @@
+#!/usr/bin/env python3
+"""Measure presented audio frames, excluding codec priming and end padding."""
+import argparse
+from fractions import Fraction
+import math
+from pathlib import Path
+import sys
+
+import av
+
+
+class DurationExceeded(ValueError):
+    pass
+
+
+def decoded_duration(audio: Path, maximum_seconds: float) -> float:
+    if not math.isfinite(maximum_seconds) or maximum_seconds <= 0:
+        raise ValueError("Invalid duration limit")
+    duration = Fraction(0)
+    with av.open(str(audio)) as container:
+        if not container.streams.audio:
+            raise ValueError("No audio stream")
+        for frame in container.decode(container.streams.audio[0]):
+            if frame.sample_rate <= 0 or frame.samples <= 0:
+                raise ValueError("Invalid decoded audio frame")
+            presented = Fraction(frame.samples, frame.sample_rate)
+            # AAC containers may present only part of the last decoded frame.
+            # MP3/Opus decoders already remove priming and trailing padding.
+            if frame.duration > 0 and frame.time_base is not None:
+                presented = min(presented, frame.duration * frame.time_base)
+            duration += presented
+            if duration > maximum_seconds:
+                raise DurationExceeded("Audio exceeds maximum duration")
+    if duration <= 0:
+        raise ValueError("No decoded audio")
+    return float(duration)
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("audio", type=Path)
+    parser.add_argument("--maximum-seconds", required=True, type=float)
+    args = parser.parse_args()
+    try:
+        print(decoded_duration(args.audio, args.maximum_seconds))
+    except DurationExceeded:
+        sys.exit(3)
+    except (ValueError, av.FFmpegError):
+        sys.exit(1)
