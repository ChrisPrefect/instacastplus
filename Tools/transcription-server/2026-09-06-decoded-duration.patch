+#!/usr/bin/env python3
+"""Real MP3 gapless decoding must define both worker and ASR timeline ends."""
+import argparse
+from fractions import Fraction
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+from unittest.mock import patch
+import av
+
+parser = argparse.ArgumentParser()
+parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parents[1])
+parser.add_argument("--episode-audio", type=Path)
+args = parser.parse_args()
+sys.path[:0] = [str(args.root), str(args.root / "tools")]
+from app import worker
+import transcribe_podcast_parallel as parallel
+
+def decoded_seconds(path):
+    with av.open(str(path)) as container:
+        return float(sum((Fraction(frame.samples, frame.sample_rate)
+                          for frame in container.decode(container.streams.audio[0])), Fraction(0)))
+
+class DurationTests(unittest.TestCase):
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory()
+        self.addCleanup(self.directory.cleanup)
+        self.audio = Path(self.directory.name) / "gapless.mp3"
+        subprocess.run(["ffmpeg", "-v", "error", "-f", "lavfi", "-i",
+                        "anullsrc=sample_rate=44100:channel_layout=mono", "-t", "0.25",
+                        "-codec:a", "libmp3lame", str(self.audio)], check=True)
+        self.expected = decoded_seconds(self.audio)
+        self.assertAlmostEqual(self.expected, 0.25, places=9)
+
+    def test_worker_uses_decoded_samples(self):
+        with patch.object(worker, "check_worker_resources"):
+            self.assertAlmostEqual(worker.audio_duration(self.audio), self.expected, places=9)
+
+    def test_asr_chunk_plan_uses_decoded_samples(self):
+        self.assertAlmostEqual(parallel.audio_duration(self.audio), self.expected, places=9)
+
+    def test_aac_pcm_and_opus_presented_duration(self):
+        for extension, codec in [("m4a", "aac"), ("wav", "pcm_s16le"), ("ogg", "libopus")]:
+            with self.subTest(codec=codec):
+                audio = Path(self.directory.name) / ("fixture." + extension)
+                subprocess.run(["ffmpeg", "-v", "error", "-f", "lavfi", "-i",
+                                "anullsrc=sample_rate=44100:channel_layout=mono", "-t", "0.25",
+                                "-codec:a", codec, str(audio)], check=True)
+                with patch.object(worker, "check_worker_resources"):
+                    self.assertAlmostEqual(worker.audio_duration(audio), 0.25, places=9)
+                self.assertAlmostEqual(parallel.audio_duration(audio), 0.25, places=9)
+
+    def test_limit_stops_decode_with_terminal_duration_error(self):
+        with patch.object(worker, "check_worker_resources"), patch.object(worker.config, "MAX_AUDIO_DURATION_SECONDS", 0.1):
+            with self.assertRaisesRegex(RuntimeError, "audio_duration_exceeded"):
+                worker.audio_duration(self.audio)
+
+    def test_corrupt_audio_is_rejected(self):
+        self.audio.write_bytes(b"not audio")
+        with patch.object(worker, "check_worker_resources"):
+            with self.assertRaisesRegex(RuntimeError, "audio_duration_invalid"):
+                worker.audio_duration(self.audio)
+
+    @unittest.skipUnless(args.episode_audio, "optional real iPhone audio")
+    def test_reported_episode_matches_ios_duration(self):
+        self.assertAlmostEqual(decoded_seconds(args.episode_audio), 772.843174603, places=8)
+        with patch.object(worker, "check_worker_resources"):
+            self.assertAlmostEqual(worker.audio_duration(args.episode_audio), 772.843174603, places=8)
+
+unittest.main(argv=[sys.argv[0]])
