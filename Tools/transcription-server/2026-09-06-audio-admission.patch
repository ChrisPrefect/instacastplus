+def verify_requested_audio(con: Any, episode_id: int, actual: str) -> bool:
+    """Reject only mismatching interests; never overwrite another client's source."""
+    con.execute("""UPDATE transcription_requests SET state='audio_unverified',updated_at=?
+        WHERE episode_id=? AND state='active' AND audio_sha256 IS NULL""", (now_iso(),episode_id))
+    con.execute("""UPDATE transcription_requests SET state='audio_mismatch',updated_at=?
+        WHERE episode_id=? AND state='active' AND audio_sha256!=?""",
+        (now_iso(), episode_id, actual))
+    return con.execute("""SELECT 1 FROM transcription_requests WHERE episode_id=?
+        AND state='active' AND audio_sha256=? LIMIT 1""", (episode_id, actual)).fetchone() is not None
+
+
+def check_request_audio(con: Any, row: Any) -> Any:
+    if not row or row["state"] != "active" or row["episode_id"] is None:
+        return row
+    episode_id = row["episode_id"]
+    job = con.execute("""SELECT verified_audio_sha256 FROM jobs WHERE episode_id=?
+        AND job_type='transcribe' AND status IN ('queued','running','paused') ORDER BY id DESC LIMIT 1""",
+        (episode_id,)).fetchone()
+    if job:
+        actual = job["verified_audio_sha256"]
+    else:
+        episode = con.execute("SELECT status,audio_sha256 FROM episodes WHERE id=?", (episode_id,)).fetchone()
+        actual = episode["audio_sha256"] if episode and episode["status"] == "ready" else None
+    if actual and row["audio_sha256"] != actual:
+        con.execute("""UPDATE transcription_requests SET state='audio_mismatch',updated_at=?
+            WHERE client_hash=? AND request_id=? AND state='active'""",
+            (now_iso(),row["client_hash"],row["request_id"]))
+        return request_record(con,row["client_hash"],row["request_id"])
+    return row
 
