+#!/usr/bin/env python3
+"""Opt-in real public download, isolated database, forbidden ASR invocation."""
+import argparse
+import json
+from pathlib import Path
+import sys
+import unittest
+from unittest.mock import patch
+sys.path.insert(0,str(Path(__file__).resolve().parent))
+import queue_admission_regression as admission
+from app import main,worker
+from starlette.requests import Request
+
+parser=argparse.ArgumentParser()
+parser.add_argument('--source-url-file',type=Path,required=True)
+args=parser.parse_args()
+source_url=args.source_url_file.read_text().strip()
+
+class DownloadPreflightTest(unittest.TestCase):
+    setUp=admission.AdmissionTests.setUp
+    assert_error=admission.AdmissionTests.assert_error
+    def test_real_download_is_rejected_before_asr(self):
+        request=Request({'type':'http','headers':[(b'x-client',b'isolated-download-test')]})
+        rid='11111111-1111-4111-8111-111111111111'
+        payload=main.EpisodeRequest(episode_url=source_url,title='Isolated source verification',
+            client_audio_sha256='0'*64,client_duration_seconds=0.0,wait_seconds=0,force=False,client_request_id=rid)
+        main.submit_episode(payload,request,1)
+        with patch.object(worker,'transcription_provider_status',return_value=None),patch.object(worker,'transcribe_block_reason',return_value=None):
+            job=worker.claim_job('isolated-download')
+        with worker.job_claim(job),patch.object(worker,'transcription_language_status',return_value=None),patch.object(worker,'run_command') as asr,patch.object(worker,'audio_duration') as duration:
+            with self.assertRaisesRegex(worker.TranscriptionJobError,'audio_source_mismatch'):
+                worker.run_transcribe(job,{'source':'api_episode'})
+            asr.assert_not_called()
+            duration.assert_not_called()
+        self.assert_error(lambda:main.get_client_request(rid,request,1),409,'audio_source_mismatch')
+        media=list(Path(self.temp.name).rglob('*.mp3'))
+        self.assertTrue(any(p.stat().st_size>1000000 for p in media),'No complete public audio download was exercised')
+        print(json.dumps({'real_download':True,'asr_invocations':asr.call_count,'source_mismatch_reported':True,'production_database_written':False}))
+
+result=unittest.TextTestRunner().run(unittest.defaultTestLoader.loadTestsFromTestCase(DownloadPreflightTest))
+sys.exit(0 if result.wasSuccessful() else 1)
