+#!/usr/bin/env python3
+"""Real process interruption and restart against a disposable SQLite queue.
+
+No network, ASR, model inference, or production database is used. The real
+claim, subprocess supervision, checkpoint-copy and completion paths run.
+"""
+import hashlib
+import json
+import os
+from pathlib import Path
+import signal
+import subprocess
+import sys
+import tempfile
+import time
+from unittest.mock import patch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+
+def child(mode, directory):
+    from app import config, service, worker
+    from app.db import tx
+    assert config.DB_BACKEND == 'sqlite'
+    assert config.DB_PATH == directory / 'queue.sqlite3'
+    signal.signal(signal.SIGTERM, worker.stop_handler)
+    with patch.object(worker, 'transcription_provider_status', return_value=None), \
+         patch.object(worker, 'transcribe_block_reason', return_value=None):
+        if mode == 'resume':
+            worker.reset_stale_jobs()
+        job = worker.claim_job(mode)
+    assert job is not None
+    with worker.job_claim(job):
+        run = worker.prepare_claim_directory(job, directory / 'results')
+        if mode == 'start':
+            audio = run / 'audio.mp3'
+            audio.write_bytes(b'controlled original audio bytes')
+            worker.write_json_atomic(run / 'audio-checkpoint.json', {
+                'name': audio.name, 'sha256': hashlib.sha256(audio.read_bytes()).hexdigest(),
+                'audio_bytes': audio.stat().st_size, 'audio_etag': None})
+            worker.write_json_atomic(run / 'completed-analysis.json', {
+                'status': 'ready', 'purpose': 'restart-proof', 'payload': {'original': True}})
+            worker.set_episode_progress(job['episode_id'], 'transcribing', 0.42)
+            (directory / 'old-job.json').write_text(json.dumps(job))
+            program = "import os,time;from pathlib import Path;Path(" + repr(str(directory / 'child.pid')) + ").write_text(str(os.getpid()));time.sleep(120)"
+            try:
+                worker.run_command([sys.executable, '-c', program], run / 'process.log',
+                                   cwd=directory, heartbeat_job_id=job['id'])
+            except service.TranscriptionProviderUnavailable as exc:
+                worker.defer_job_for_provider(job, str(exc))
+                return
+            raise AssertionError('Long-running stage unexpectedly completed')
+        old = json.loads((directory / 'old-job.json').read_text())
+        assert job['id'] == old['id'] and job['claim_token'] != old['claim_token']
+        graceful = json.loads((directory / 'interruption.json').read_text())['graceful']
+        assert job['attempts'] == old['attempts'] + (0 if graceful else 1)
+        assert run.name != 'job-' + str(old['id']) + '-claim-' + old['claim_token']
+        assert (run / 'audio.mp3').read_bytes() == b'controlled original audio bytes'
+        assert json.loads((run / 'completed-analysis.json').read_text())['payload'] == {'original': True}
+        with tx() as con:
+            row = con.execute('SELECT processing_progress FROM episodes WHERE id=?', (job['episode_id'],)).fetchone()
+            assert row['processing_progress'] == 0.42
+        try:
+            with worker.job_claim(old):
+                worker.finish_job(old['id'])
+        except worker.JobClaimLost:
+            pass
+        else:
+            raise AssertionError('Obsolete worker was allowed to finish')
+        worker.finish_job(job['id'])
+        with tx() as con:
+            assert con.execute('SELECT COUNT(*) AS n FROM jobs').fetchone()['n'] == 1
+            assert con.execute('SELECT status FROM jobs').fetchone()['status'] == 'done'
+        print('Resumed same job with intact source/checkpoint and fenced predecessor.')
+
+
+def wait_file(path, process):
+    deadline = time.monotonic() + 15
+    while time.monotonic() < deadline:
+        if path.exists():
+            return
+        if process.poll() is not None:
+            raise AssertionError('Worker exited before interruption point')
+        time.sleep(0.05)
+    raise AssertionError('Worker did not reach interruption point')
+
+
+def scenario(graceful):
+    with tempfile.TemporaryDirectory(prefix='instacast-restart-proof-') as temporary:
+        directory = Path(temporary)
+        (directory / 'interruption.json').write_text(json.dumps({'graceful': graceful}))
+        environment = dict(os.environ, INSTACAST_DB_BACKEND='sqlite',
+                           INSTACAST_TRANSCRIPT_DB=str(directory / 'queue.sqlite3'))
+        setup = """from app.db import init_db,tx
+from app.service import ensure_episode,enqueue_job
+init_db()
+with tx() as con:
+    episode=ensure_episode(con,'https://example.org/controlled.mp3',title='Controlled restart proof')
+    enqueue_job(con,'transcribe',episode_id=episode)
+"""
+        subprocess.run([sys.executable, '-c', setup], env=environment, check=True,
+                       cwd=Path(__file__).resolve().parents[1])
+        process = subprocess.Popen([sys.executable, __file__, '--child', 'start', str(directory)],
+                                   env=environment, start_new_session=True)
+        child_pid = None
+        try:
+            wait_file(directory / 'child.pid', process)
+            child_pid = int((directory / 'child.pid').read_text())
+            process.send_signal(signal.SIGTERM if graceful else signal.SIGKILL)
+            process.wait(timeout=20)
+            if graceful:
+                assert process.returncode == 0
+                try:
+                    os.kill(child_pid, 0)
+                except ProcessLookupError:
+                    pass
+                else:
+                    raise AssertionError('Graceful shutdown left its stage running')
+            else:
+                # Host reboot/systemd control-group stop also kills the stage.
+                os.killpg(child_pid, signal.SIGKILL)
+                expire = """from app.db import tx
+with tx() as con:
+    con.execute("UPDATE jobs SET lease_until='2000-01-01T00:00:00+00:00' WHERE status='running'")
+"""
+                subprocess.run([sys.executable, '-c', expire], env=environment, check=True,
+                               cwd=Path(__file__).resolve().parents[1])
+            subprocess.run([sys.executable, __file__, '--child', 'resume', str(directory)],
+                           env=environment, check=True, timeout=20)
+        finally:
+            if process.poll() is None:
+                process.kill()
+                process.wait()
+            if child_pid:
+                try:
+                    os.killpg(child_pid, signal.SIGKILL)
+                except ProcessLookupError:
+                    pass
+    print('PASS:', 'SIGTERM service restart' if graceful else 'SIGKILL host restart')
+
+
+if __name__ == '__main__':
+    if len(sys.argv) > 1 and sys.argv[1] == '--child':
+        child(sys.argv[2], Path(sys.argv[3]))
+    else:
+        scenario(True)
+        scenario(False)
