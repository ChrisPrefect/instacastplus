+"""Explicit source/configuration identity shared by ASR producer and consumer."""
+import hashlib
+import json
+from pathlib import Path
+
+ASR_DEFAULTS = {
+    "model":"small", "compute_type":"int8", "beam_size":5, "best_of":1,
+    "batched":True, "batch_size":4, "vad":True, "word_timestamps":False,
+    "language":"auto", "initial_prompt":None, "hotwords":None,
+    "chunk_seconds":600, "chunk_overlap_seconds":60, "min_chunk_seconds":5,
+    "boundary_search_seconds":60, "silence_noise_db":-35,
+    "silence_min_seconds":0.3, "preferred_silence_seconds":0.8,
+    "silence_boundaries":True,
+}
+
+def digest(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True, ensure_ascii=False, separators=(",",":"), allow_nan=False).encode()).hexdigest()
+
+def asr_provenance(audio_sha256, options):
+    root = Path(__file__).resolve().parents[1]
+    implementation = {name:hashlib.sha256((root/"tools"/name).read_bytes()).hexdigest()
+                      for name in ("transcribe_podcast_parallel.py", "transcribe_podcast.py", "caption_contract.py")}
+    # Normalize CLI numeric parsing (600 versus 600.0) without losing options.
+    settings = {key:(float(options.get(key, value)) if isinstance(value, (int,float)) and not isinstance(value,bool)
+                     else options.get(key,value)) for key,value in ASR_DEFAULTS.items()}
+    return {"audio_sha256":audio_sha256, **settings, "implementation":implementation}
