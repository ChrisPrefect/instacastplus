+#!/usr/bin/env python3
+import sys,tempfile,unittest,json,hashlib
+from pathlib import Path
+from unittest.mock import patch
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
+from app import artifact_contract as contract, config
+class ArtifactResourceTests(unittest.TestCase):
+ def test_transcript_cues_cannot_exceed_measured_audio(self):
+  with tempfile.TemporaryDirectory() as directory:
+   paths={kind:Path(directory)/kind for kind in ['transcript_srt','chapters_json','ads_json','summary_json']}
+   paths['transcript_srt'].write_text('1\n00:00:09,000 --> 00:00:11,000\nThis exceeds the audio.\n')
+   shared={'schema_version':1,'audio_duration_seconds':10.0,'transcript_revision':'sha256:'+hashlib.sha256(paths['transcript_srt'].read_bytes()).hexdigest()}
+   paths['chapters_json'].write_text(json.dumps(dict(shared,chapters=[{'start':0.0,'end':10.0,'title':'Content','is_sponsor':False}])))
+   paths['ads_json'].write_text(json.dumps(dict(shared,segments=[])))
+   paths['summary_json'].write_text(json.dumps(dict(shared,summary='A valid summary.',topic_titles=['Content'])))
+   result=contract.validate_required_artifacts(paths,10)
+   self.assertFalse(result.valid,'Transcript cue past measured duration was published')
+   self.assertTrue(any('exceeds audio duration' in issue for issue in result.issues),result.issues)
+ def test_any_oversized_artifact_rejected_before_any_parsing(self):
+  required=['transcript_srt','chapters_json','ads_json','summary_json']
+  with tempfile.TemporaryDirectory() as directory:
+   paths={kind:Path(directory)/kind for kind in required}
+   for oversized in required:
+    with self.subTest(kind=oversized):
+     for kind,path in paths.items():path.write_bytes(b'x'*(33 if kind==oversized else 1))
+     with patch.object(config,'MAX_ARTIFACT_BYTES',32,create=True),patch.object(contract,'parse_srt',side_effect=AssertionError('Parsed before enforcing artifact byte cap')):
+      result=contract.validate_required_artifacts(paths,10)
+     self.assertFalse(result.valid)
+     self.assertTrue(any(oversized in issue and 'byte limit' in issue for issue in result.issues),result.issues)
+if __name__=='__main__':unittest.main()
