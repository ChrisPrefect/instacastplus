+            "message": "Der Podcast-Feed überschreitet die zulässige Dateigrösse.",
+            "max_feed_bytes": config.MAX_FEED_BYTES,
+        }}
+    except requests.Timeout:
+        result = {"kind": "timeout", "message": "Der Podcast-Feed antwortete nicht rechtzeitig."}
+    except Exception:
+        result = {"kind": "invalid", "message": "Der Podcast-Feed konnte nicht gelesen oder verarbeitet werden."}
+    print(json.dumps(result, ensure_ascii=False))
