+#!/usr/bin/env python3
+"""Feed resource boundaries, executed against production methods with controlled peers."""
+import os
+import subprocess
+import sys
+import tempfile
+import textwrap
+import threading
+import time
+import unittest
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+from unittest.mock import patch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from app import config, rss
+import requests
+
+class FeedTransportTests(unittest.TestCase):
+    def response(self, chunks, headers=None):
+        response = requests.Response()
+        response.status_code = 200
+        response.raw = object()
+        response.url = 'https://example.org/feed.xml'
+        response.headers.update(headers or {})
+        response.iter_content = lambda *args, **kwargs: iter(chunks)
+        response.close = lambda: None
+        return response
+
+    def test_feed_requests_stream_before_size_check(self):
+        response = self.response([b'<rss/>'])
+        with patch.object(rss, 'guarded_get', return_value=response) as get:
+            self.assertEqual(b'<rss/>', rss.fetch_response(response.url).content)
+        self.assertTrue(get.call_args.kwargs.get('stream'), 'Feed eagerly buffered before size guard')
+
+    def test_declared_oversize_reads_no_body(self):
+        response = self.response([], {'Content-Length': '9'})
+        def body(*args, **kwargs):
+            self.fail('Oversized declared body consumed')
+        response.iter_content = body
+        with patch.object(rss, 'guarded_get', return_value=response), patch.object(config, 'MAX_FEED_BYTES', 8):
+            with self.assertRaisesRegex(ValueError, 'gross'):
+                rss.fetch_response(response.url)
+
+    def test_unknown_length_stops_at_limit_crossing(self):
+        response = self.response([])
+        consumed = []
+        def body(*args, **kwargs):
+            for chunk in [b'12345', b'67890', b'must never read']:
+                consumed.append(chunk)
+                yield chunk
+        response.iter_content = body
+        with patch.object(rss, 'guarded_get', return_value=response), patch.object(config, 'MAX_FEED_BYTES', 8):
+            with self.assertRaisesRegex(ValueError, 'gross'):
+                rss.fetch_response(response.url)
+        self.assertEqual(2, len(consumed), 'Whole unbounded body consumed before enforcing cap')
+
+    def test_content_encoding_does_not_bypass_decoded_byte_cap(self):
+        response = self.response([b'12345', b'67890'], {'Content-Length': '3', 'Content-Encoding': 'gzip'})
+        with patch.object(rss, 'guarded_get', return_value=response), patch.object(config, 'MAX_FEED_BYTES', 8):
+            with self.assertRaisesRegex(ValueError, 'gross'):
+                rss.fetch_response(response.url)
+
+    def test_whole_feed_deadline_kills_blocked_child(self):
+        # A blocked DNS/read/parser surrogate in a real OS child. Parent's
+        # independent timeout also proves the old implementation never enforces it.
+        with tempfile.TemporaryDirectory() as directory:
+            sleeper = Path(directory) / 'blocked-python'
+            pidfile = Path(directory) / 'pid'
+            sleeper.write_text('#!' + sys.executable + '\nimport os,time\nopen(' + repr(str(pidfile)) + ',"w").write(str(os.getpid()))\ntime.sleep(30)\n')
+            sleeper.chmod(0o755)
+            source = textwrap.dedent('''
+                import sys,time
+                from unittest.mock import patch
+                from app import rss,config
+                import requests
+                config.FEED_FETCH_TIMEOUT_SECONDS = .15
+                # Old path blocks in fetch_response; bounded path blocks inside
+                # the actual child executable and must kill/wait it.
+                with patch.object(rss, 'validate_public_url', side_effect=lambda url,*a,**kw:url), patch.object(rss, 'fetch_response', side_effect=lambda url:time.sleep(30)), patch.object(sys, 'executable', EXECUTABLE):
+                    try:rss.fetch_feed('https://example.org/feed.xml')
+                    except requests.Timeout:print('bounded timeout')
+                    else:raise AssertionError('No total timeout')
+            ''').replace('EXECUTABLE', repr(str(sleeper)))
+            env = dict(os.environ, PYTHONPATH=str(Path(rss.__file__).resolve().parents[1]))
+            try:
+                result = subprocess.run([sys.executable, '-c', source], env=env, capture_output=True, text=True, timeout=2)
+            except subprocess.TimeoutExpired:
+                self.fail('Feed DNS/body/parser has no total operation deadline')
+            self.assertEqual(0, result.returncode, result.stderr)
+            self.assertIn('bounded timeout', result.stdout)
+            if pidfile.exists():
+                with self.assertRaises(ProcessLookupError):os.kill(int(pidfile.read_text()), 0)
+
+    def test_cancellation_before_network_does_not_start_child(self):
+        def cancelled():raise InterruptedError('operator stopped')
+        with self.assertRaisesRegex(InterruptedError, 'operator stopped'):
+            rss.fetch_feed('https://example.org/feed.xml', check_cancelled=cancelled)
+
+    def test_cancellation_reaps_child_already_blocked(self):
+        with tempfile.TemporaryDirectory() as directory:
+            runner = Path(directory) / 'blocked-python'
+            pidfile = Path(directory) / 'pid'
+            runner.write_text('#!' + sys.executable + '\nimport os,time\nopen(' + repr(str(pidfile)) + ',"w").write(str(os.getpid()))\ntime.sleep(30)\n')
+            runner.chmod(0o755)
+            calls = 0
+            def check():
+                nonlocal calls
+                calls += 1
+                if calls >= 4:raise InterruptedError('worker stopped')
+            with patch.object(sys, 'executable', str(runner)):
+                with self.assertRaisesRegex(InterruptedError, 'worker stopped'):
+                    rss.fetch_feed('https://example.org/feed.xml', check_cancelled=check)
+            self.assertTrue(pidfile.exists())
+            with self.assertRaises(ProcessLookupError):os.kill(int(pidfile.read_text()), 0)
+
+    def test_url_policy_survives_process_boundary(self):
+        with self.assertRaises(rss.HTTPException) as error:
+            rss.fetch_feed('file:///private-file')
+        self.assertEqual(400, error.exception.status_code)
+
+    def test_real_transport_success_errors_redirects_and_cleanup(self):
+        xml = b'<rss><channel><title>Fixture</title><item><title>Episode</title><guid>test</guid><enclosure url="https://example.org/audio.mp3"/></item></channel></rss>'
+        class Handler(BaseHTTPRequestHandler):
+            def log_message(self, *args):pass
+            def do_GET(self):
+                if self.path == '/redirect':
+                    self.send_response(302);self.send_header('Location', '/feed');self.end_headers();return
+                if self.path == '/missing':
+                    self.send_response(404);self.end_headers();return
+                if self.path == '/oversized':body = b'x' * 2048
+                elif self.path == '/invalid':body = b'invalid feed'
+                else:body = xml
+                self.send_response(200);self.send_header('Content-Length', str(len(body)));self.end_headers()
+                self.wfile.write(body)
+        server = ThreadingHTTPServer(('127.0.0.1', 0), Handler)
+        thread = threading.Thread(target=server.serve_forever, daemon=True);thread.start()
+        try:
+            with tempfile.TemporaryDirectory() as directory:
+                # Only the test executable allows loopback, keeping the production
+                # SSRF policy intact. All requests, redirects, decoding and IPC are real.
+                runner = Path(directory) / 'fixture-python'
+                runner.write_text('#!' + sys.executable + '\nimport sys\nsys.path.insert(0,' + repr(str(Path(rss.__file__).resolve().parents[1])) + ')\nfrom app import rss,security\nsecurity.validate_public_url = rss.validate_public_url = lambda url,*a,**kw:url\nrss._main()\n')
+                runner.chmod(0o755)
+                base = 'http://127.0.0.1:' + str(server.server_port)
+                with patch.object(sys, 'executable', str(runner)), patch.object(config, 'MAX_FEED_BYTES', 1024), patch.object(config, 'FEED_FETCH_TIMEOUT_SECONDS', 5):
+                    for path in ['/feed', '/redirect']:
+                        result = rss.fetch_feed(base + path)
+                        self.assertEqual('Fixture', result['title'])
+                        self.assertEqual('test', result['episodes'][0]['guid'])
+                    with self.assertRaises(rss.HTTPException) as error:rss.fetch_feed(base + '/missing')
+                    self.assertEqual(404, error.exception.status_code)
+                    with self.assertRaises(rss.HTTPException) as oversized:rss.fetch_feed(base + '/oversized')
+                    self.assertEqual(413, oversized.exception.status_code)
+                    self.assertEqual('feed_too_large', oversized.exception.detail['code'])
+                    self.assertFalse(oversized.exception.detail['retryable'])
+                    with self.assertRaisesRegex(ValueError, 'verarbeitet'):rss.fetch_feed(base + '/invalid')
+        finally:
+            server.shutdown();server.server_close();thread.join()
+
+if __name__ == '__main__':unittest.main()
