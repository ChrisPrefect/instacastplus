+def exact_url_predicate(column: str) -> str:
+    # Callers use fixed schema identifiers; values remain bound parameters.
+    if column not in {"episode_url", "episode_aliases.url", "url"}:
+        raise ValueError("Unsupported URL lookup column")
+    return f"{column}_sha256=SHA2(?,256)" if is_mysql() else f"{column}=?"
+
+
+def ensure_state_columns(con: Any) -> None:
+    for table, column in (("episodes","terminal_error"),("episodes","latest_source_url"),
+                          ("jobs","source_url"),("jobs","next_attempt_at")):
+        ensure_column(con,table,column,"TEXT")
+    con.execute("UPDATE episodes SET latest_source_url=episode_url WHERE latest_source_url IS NULL")
+    con.execute("UPDATE jobs SET source_url=(SELECT episode_url FROM episodes WHERE episodes.id=jobs.episode_id) WHERE job_type='transcribe' AND source_url IS NULL")
+    con.execute("""UPDATE episodes SET terminal_error=(SELECT error FROM jobs WHERE jobs.episode_id=episodes.id
+        AND jobs.status='failed' ORDER BY jobs.id DESC LIMIT 1) WHERE episodes.status='failed' AND terminal_error IS NULL""")
+
+
+def ensure_exact_url_indexes(con: Any) -> None:
+    # Run with admission/workers stopped. Install the exact identity before
+    # removing the old512-character uniqueness constraint; reruns are idempotent.
+    for table, column, old_index in (("episodes","episode_url","uniq_episodes_episode_url"),
+                                     ("episode_aliases","url","uniq_episode_aliases_url"),
+                                     ("podcasts","feed_url","uniq_podcasts_feed_url")):
+        digest_column = column + "_sha256"
+        ensure_column(con,table,digest_column,f"CHAR(64) GENERATED ALWAYS AS (SHA2({column},256)) STORED")
+        index = "uniq_" + table + "_full_url"
+        if not con.execute(f"SHOW INDEX FROM {table} WHERE Key_name=?",(index,)).fetchone():
+            con.execute(f"CREATE UNIQUE INDEX {index} ON {table}({digest_column})")
+        if con.execute(f"SHOW INDEX FROM {table} WHERE Key_name=?",(old_index,)).fetchone():
+            con.execute(f"ALTER TABLE {table} DROP INDEX {old_index}")
 
 
 VALID_IDENTIFIER = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
