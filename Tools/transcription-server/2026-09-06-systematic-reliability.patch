+def fetch_feed(feed_url: str, *, check_cancelled: Callable[[], None] | None = None) -> dict[str, Any]:
+    """Bound DNS, redirects, discovery, body decoding and XML parsing together.
+
+    A fresh interpreter avoids forking API threads or their database connections.
+    The supervisor always reaps it, including cancellation and timeout paths.
+    """
+    if check_cancelled:
+        check_cancelled()
+    deadline = time.monotonic() + config.FEED_FETCH_TIMEOUT_SECONDS
+    child = subprocess.Popen(
+        [sys.executable, "-m", "app.rss"], cwd=str(config.ROOT),
+        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+    )
+    payload = json.dumps({"url": feed_url, "max_bytes": config.MAX_FEED_BYTES}).encode()
+    try:
+        while True:
+            if check_cancelled:
+                check_cancelled()
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                raise requests.Timeout("Der Podcast-Feed überschritt das Gesamtzeitlimit.")
+            try:
+                output, _ = child.communicate(input=payload, timeout=min(.2, remaining))
+                break
+            except subprocess.TimeoutExpired:
+                payload = None
+        if check_cancelled:
+            check_cancelled()
+        if time.monotonic() >= deadline:
+            raise requests.Timeout("Der Podcast-Feed überschritt das Gesamtzeitlimit.")
+        if child.returncode != 0:
+            raise RuntimeError("Der Podcast-Feed konnte nicht verarbeitet werden.")
+        result = json.loads(output)
+        if "feed" in result:
+            return result["feed"]
+        if result.get("kind") == "http":
+            raise HTTPException(status_code=result["status"], detail=result["detail"])
+        if result.get("kind") == "timeout":
+            raise requests.Timeout(result["message"])
+        raise ValueError(result["message"])
+    finally:
+        if child.poll() is None:
+            child.kill()
+        child.communicate()
+
+
+def _main() -> None:
+    request = json.load(sys.stdin)
+    config.MAX_FEED_BYTES = int(request["max_bytes"])
+    try:
+        result = {"feed": _fetch_feed(request["url"])}
+    except HTTPException as exc:
+        result = {"kind": "http", "status": exc.status_code, "detail": exc.detail}
+    except requests.HTTPError as exc:
+        status = exc.response.status_code if exc.response is not None else 502
+        result = {"kind": "http", "status": status,
+                  "detail": f"Der Podcast-Feed antwortete mit HTTP {status}."}
+    except FeedTooLargeError:
+        result = {"kind": "http", "status": 413, "detail": {
